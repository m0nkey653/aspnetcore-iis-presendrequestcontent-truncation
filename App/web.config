<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\App.dll" hostingModel="inprocess" />
      <modules>
        <!-- A .NET Framework IHttpModule with a no-op PreSendRequestContent handler.
             Remove this line (or set the app pool to "No Managed Code") and the response is complete. -->
        <add name="PreSendModule" type="PreSendModule.Module, PreSendModule" />
      </modules>
    </system.webServer>
  </location>
</configuration>
